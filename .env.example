# LINKUP environment configuration
# Copy to .env and adjust as needed. All values are optional — the API
# works out of the box with the defaults below.

# HTTP port for the LINKUP API
PORT=3001

# development | test | production
NODE_ENV=development

# SQLite database file. Defaults to packages/db/data/linkup.db inside this repo.
# DATABASE_PATH=./packages/db/data/linkup.db

# Hello Minds provider (optional). When both values are set, Mind queries are
# sent to the real Minds provider; otherwise the API falls back to the stub
# adapter and /mind/query returns 503. Get a Builder API key at
# build.hellominds.ai/console; the Mind ID identifies which Mind to message.
# MINDS_BUILDER_API_KEY=
# MINDS_MIND_ID=

# Milliseconds to wait for a Mind reply before timing out (default 120000).
# MINDS_REPLY_TIMEOUT_MS=120000
