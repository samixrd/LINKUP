# ==============================================================================
# LINKUP Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the servers:
#   cp .env.example .env
#
# NOTE: LINKUP works 100% OUT OF THE BOX without any external API keys
# using our built-in Deterministic AI Mind Stub & Local Fallback engine.
# Adding Hello Minds or Groq credentials enables live cloud LLM reasoning.
# ==============================================================================

# Server & Runtime Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=packages/db/data/linkup.db

# (Optional) Hello Minds Cloud Provider
# Register at https://minds.animoca.com to get your Builder API key and Mind ID
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=
MINDS_REPLY_TIMEOUT_MS=120000

# (Optional) Groq Fast Fallback Provider (OpenAI-compatible)
# Used if Minds API key is absent or quota is exceeded
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# (Optional) Web Client API Base URL (leave blank for local proxy to http://localhost:3001)
# VITE_API_BASE=http://localhost:3001
