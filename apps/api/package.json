  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3",
    "@linkup/db": "^0.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.12"
  }
}
