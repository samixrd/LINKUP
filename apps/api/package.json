{
  "name": "@linkup/api",
  "private": true,
  "version": "0.1.0",
  "description": "LINKUP API server: HTTP layer for the LINKUP backend.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
